{
	"compileOnSave": false,
	"compilerOptions": {
		"baseUrl": "src",
		"paths": {
			"@finance/*": ["app/finance/*"],
			"@app/*": ["app/*"],
			"@test-helpers/*": ["test-helpers/"],
			"assert": ["./url"]
		},
		"outDir": "./dist/out-tsc",
		"sourceMap": true,
		"declaration": false,
		"downlevelIteration": true,
		"experimentalDecorators": true,
		"module": "es2020",
		"moduleResolution": "node",
		"importHelpers": true,
		"target": "es2015",
		"types": ["googlemaps", "jasmine"],
		"typeRoots": ["node_modules/@types"],
		"lib": ["es2018", "dom"],
		"removeComments": true
	},
	"angularCompilerOptions": {
		"fullTemplateTypeCheck": true,
		"strictInjectionParameters": true
	},
	"include": ["src/**/*.ts", "./cypress"]
}
